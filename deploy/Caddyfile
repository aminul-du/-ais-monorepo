{
	# email me@aminul-du.com     # uncomment when DNS ready
}

https://localhost {
	tls internal

	# Backends — handle_path strips the prefix before forwarding
	handle_path /api/* {
		reverse_proxy ai-orchestrator:8080
	}
	handle_path /core/* {
		reverse_proxy core-api:8080
	}

	# Caddy-level health probe (bypasses backend)
	handle /caddy-health {
		respond "ok" 200
	}

	# Everything else → Next.js
	handle {
		reverse_proxy web:3000
	}

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

http://localhost {
	redir https://{host}{uri} permanent
}

